+#!/usr/bin/env python3
+"""Regenerate the EngineV2 book metrics from the deck + a monthly-returns panel.
+
+    python reproduce.py                          # all books, 60k paths, canonical panel -> metrics.csv
+    python reproduce.py --check                  # ...and compare with reference/R8_Books_Metrics_20260903.csv
+    python reproduce.py --books R3b,R3dK --npaths 10000     # quick look
+    python reproduce.py --flex                   # add the flexible-draw guardrail columns
+    ENGINEV2_PANEL=/path/etf-eod/monthly_returns.csv python reproduce.py      # live panel (see README: not digit-exact)
+    ENGINEV2_PRICES=/path/etf-eod/prices ENGINEV2_ASOF=2026-08-21 python reproduce.py
+
+Per book: r_net = deck row-blend minus expense ratios (percent -> decimal), sigma = 48-month
+live-weight-renormalized vol of the book's monthly returns ending ENGINEV2_END (default 2026-08),
+then the engine-exact Monte Carlo (60k paths, seed 42, yearly Markov redraw lambda 1/8, fixed
+3%-of-initial year-end draw) under 4 conventions: robust/canonical scenario weights x G/L drift.
+geo_PathCE = exp(mean ln PathCE) over the 4 conventions; also on the C-haircut deck (C-grade rows
+shrunk 25% toward the deck's column median) and with a -200bp level shift. Closed-form: worst
+net CAGR, DRB40 at the 6% hurdle, WER, vol48, turnover vs P1.
+"""
+import argparse, json, os, sys, time
+import numpy as np, pandas as pd
+import lib_pathce as L
+from core import UNIV, IDX, DECKM, ERV, sigma_of, wvec, P1v, CONVS
+from flexdraw import run_flex
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+
+
+def engine_exact(r_net, sigma, npaths):
+    """Stream convention that reproduces the reference numbers: robust G,L share one rng(42)
+    stream; canonical G,L a fresh rng(42)."""
+    L.NP_ = npaths
+    out = {}
+    rng = np.random.default_rng(42)
+    for conv in ("G", "L"):
+        out[("robust", conv)] = L.run_engine(rng, r_net + 0.0, L.PI_ROBUST, conv, sigma, 0.0)
+    rng = np.random.default_rng(42)
+    for conv in ("G", "L"):
+        out[("canonical", conv)] = L.run_engine(rng, r_net + 0.0, L.PI_CANON, conv, sigma, 0.0)
+    return out
+
+
+def flex_exact(r_net, sigma, npaths):
+    L.NP_ = npaths
+    out = {}
+    rng = np.random.default_rng(42)
+    for conv in ("G", "L"):
+        out[("robust", conv)] = run_flex(rng, r_net, L.PI_ROBUST, conv, sigma)
+    rng = np.random.default_rng(42)
+    for conv in ("G", "L"):
+        out[("canonical", conv)] = run_flex(rng, r_net, L.PI_CANON, conv, sigma)
+    return out
+
+
+def geo(mc):
+    return float(np.exp(np.mean([np.log(mc[c]["PathCE"]) for c in CONVS])))
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--books", default="all", help="comma list of names in books.json, or all")
+    ap.add_argument("--npaths", type=int, default=60000)
+    ap.add_argument("--grades", default="Row_Grades_R8cand_20260903.csv")
+    ap.add_argument("--out", default="metrics.csv")
+    ap.add_argument("--check", action="store_true", help="compare with reference/R8_Books_Metrics_20260903.csv")
+    ap.add_argument("--flex", action="store_true", help="add flexible-draw (3%% -> 2.25%% below 0.80x, restore at 1.0x) columns")
+    a = ap.parse_args()
+
+    books = json.load(open(os.path.join(HERE, "books.json")))
+    books = {k: v for k, v in books.items() if not k.startswith("_")}
+    names = list(books) if a.books == "all" else a.books.split(",")
+    grades = pd.read_csv(os.path.join(L.DECKS, a.grades)).set_index("Ticker")["Grade"]
+    colmed = np.median(DECKM, axis=0)
+    HCC = DECKM.copy()
+    for i, t in enumerate(UNIV):
+        if grades.get(t, "B") == "C":
+            HCC[i] = 0.75 * DECKM[i] + 0.25 * colmed
+
+    rows = []
+    for nm in names:
+        t0 = time.time()
+        d = books[nm]
+        missing = [t for t in d if t not in IDX]
+        if missing:
+            print(f"{nm}: skipped, not in universe: {missing}", file=sys.stderr); continue
+        w = wvec(d); wer = float(ERV @ w); sig = sigma_of(w); r = DECKM.T @ w - wer
+        mc = engine_exact(r, sig, a.npaths)
+        mch = engine_exact(HCC.T @ w - wer, sig, a.npaths)
+        mcl = engine_exact(r - 0.02, sig, a.npaths)
+        rg, lg = mc[("robust", "G")], mcl[("robust", "G")]
+        row = dict(Portfolio=nm, geo_PathCE=round(geo(mc), 2), geo_Chaircut=round(geo(mch), 2), geo_LS200=round(geo(mcl), 2),
+                   PathCE_robG=round(rg["PathCE"], 2), P5_robG=round(rg["P5"], 2), ruin_robG=rg["ruin"],
+                   LS_P5_robG=round(lg["P5"], 2), LS_ruin_robG=lg["ruin"], worst_pct=round(float(r.min()) * 100, 2),
+                   DRB40_h6=round(L.drb40(r, h=0.06), 4), WER_pct=round(wer * 100, 3), vol48_pct=round(sig * 100, 2),
+                   turnover_pct=round(50 * np.abs(w - P1v).sum(), 0))
+        if a.flex:
+            fx = flex_exact(r, sig, a.npaths); xg = fx[("robust", "G")]
+            row.update(flex_geo_PathCE=round(geo(fx), 2), flex_ruin_robG=xg["ruin"], flex_P5_robG=round(xg["P5"], 2),
+                       flex_yrs_reduced_pct=round(xg["yrs_red"] * 100, 1), flex_draws_vs_fixed_pct=round(xg["draw"] / 1.20 * 100, 0))
+        rows.append(row)
+        print(f"{nm:10s} geo={row['geo_PathCE']:.2f} HCC={row['geo_Chaircut']:.2f} LS={row['geo_LS200']:.2f} | robG P5={row['P5_robG']:.2f} ruin={row['ruin_robG']} | LS P5={row['LS_P5_robG']:.2f} ruin={row['LS_ruin_robG']} | worst={row['worst_pct']:.2f}% vol={row['vol48_pct']:.2f} ({time.time()-t0:.0f}s)", flush=True)
+    df = pd.DataFrame(rows)
+    df.to_csv(a.out, index=False)
+    print("wrote", a.out)
+
+    if a.check:
+        ref = pd.read_csv(os.path.join(HERE, "reference", "R8_Books_Metrics_20260903.csv")).set_index("Portfolio")
+        cols = [c for c in ref.columns if c in df.columns]
+        bad = 0
+        for _, r in df.set_index("Portfolio").iterrows():
+            if r.name not in ref.index:
+                continue
+            diffs = {c: (r[c], ref.loc[r.name, c]) for c in cols if not np.isclose(r[c], ref.loc[r.name, c], rtol=0, atol=1e-9)}
+            status = "EXACT" if not diffs else f"DIFF {diffs}"
+            bad += bool(diffs)
+            print(f"check {r.name:10s}: {status}")
+        print("reference reproduced to the digit" if not bad else f"{bad} book(s) differ (expected when npaths != 60000 or a non-canonical panel is used)")
+        return 1 if bad else 0
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
